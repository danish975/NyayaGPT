# Copy to .env.local for local development (or set these in your host / docker compose).

# Optional: without it, the chat returns built-in demo answers.
GROQ_API_KEY=
# Optional: Groq model ID (default: openai/gpt-oss-120b).
GROQ_MODEL=

# Hybrid retrieval (BM25 + local multilingual embeddings). All optional.
# Set HYBRID_RETRIEVAL=off to use BM25 only and skip the ~120 MB model download.
HYBRID_RETRIEVAL=
EMBEDDING_MODEL=
HYBRID_MIN_SIMILARITY=

# Admin dashboard login. Required in production (no default password there).
# In development, if ADMIN_PASSWORD is empty, admin / admin123 is accepted.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs admin session cookies and chat answers. Required in production, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
